{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "archive/**",
      "scratch/**",
      "corporate_team/**/*.mp4",
      "corporate_team/**/*.mov",
      "**/*.py",
      "**/*.bat",
      "**/*.sh",
      "**/*.ps1",
      "**/*.md",
      "package.json",
      "package-lock.json"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
